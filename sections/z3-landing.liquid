{%- comment -%}
  Z3 Collective — Launch Landing Section
  Drop this file into a Dawn theme's /sections folder.
  Everything below (colors, text, products, email signup) is editable
  in the Shopify theme editor — no code changes needed.
{%- endcomment -%}

{%- style -%}
  #z3-{{ section.id }} {
    --z3-accent: {{ section.settings.accent_color }};
    --z3-bg: {{ section.settings.bg_color }};
    --z3-text: {{ section.settings.text_color }};
    background: var(--z3-bg);
    color: var(--z3-text);
  }
  #z3-{{ section.id }} .z3-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 48px 20px 64px;
  }
  #z3-{{ section.id }} .z3-hero {
    text-align: center;
    padding: 40px 0 24px;
  }
  #z3-{{ section.id }} .z3-logo { max-width: 160px; height: auto; margin: 0 auto 24px; }
  #z3-{{ section.id }} .z3-hero h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.05;
    margin: 0 0 16px;
  }
  #z3-{{ section.id }} .z3-hero p { font-size: 1.15rem; max-width: 620px; margin: 0 auto; opacity: .9; }
  #z3-{{ section.id }} .z3-story {
    display: grid;
    gap: 28px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    margin: 56px 0;
  }
  #z3-{{ section.id }} .z3-story-card h3 { margin: 0 0 8px; font-size: 1.25rem; color: var(--z3-accent); }
  #z3-{{ section.id }} .z3-story-card p { margin: 0; opacity: .9; }
  #z3-{{ section.id }} .z3-preview-title { text-align: center; font-size: 1.8rem; margin: 48px 0 8px; }
  #z3-{{ section.id }} .z3-preview-sub { text-align: center; opacity: .75; margin: 0 0 32px; }
  #z3-{{ section.id }} .z3-grid {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  #z3-{{ section.id }} .z3-product { text-align: center; }
  #z3-{{ section.id }} .z3-product img { width: 100%; height: auto; border-radius: 12px; aspect-ratio: 1/1; object-fit: cover; }
  #z3-{{ section.id }} .z3-product .z3-ph {
    width: 100%; aspect-ratio: 1/1; border-radius: 12px;
    background: color-mix(in srgb, var(--z3-accent) 15%, transparent);
    display: flex; align-items: center; justify-content: center;
    font-size: 2.5rem;
  }
  #z3-{{ section.id }} .z3-product h4 { margin: 14px 0 4px; font-size: 1.1rem; }
  #z3-{{ section.id }} .z3-product .z3-tag { font-size: .85rem; color: var(--z3-accent); font-weight: 600; }
  #z3-{{ section.id }} .z3-signup {
    margin: 64px auto 0;
    max-width: 540px;
    text-align: center;
    padding: 40px 24px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--z3-accent) 10%, transparent);
  }
  #z3-{{ section.id }} .z3-signup h3 { margin: 0 0 8px; font-size: 1.5rem; }
  #z3-{{ section.id }} .z3-signup p { margin: 0 0 20px; opacity: .85; }
  #z3-{{ section.id }} .z3-form { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  #z3-{{ section.id }} .z3-form input[type="email"] {
    flex: 1 1 220px; padding: 12px 14px; border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--z3-text) 25%, transparent);
    font-size: 1rem;
  }
  #z3-{{ section.id }} .z3-form button {
    padding: 12px 22px; border: none; border-radius: 8px; cursor: pointer;
    background: var(--z3-accent); color: #fff; font-size: 1rem; font-weight: 600;
  }
  #z3-{{ section.id }} .z3-success { margin-top: 12px; color: var(--z3-accent); font-weight: 600; }
{%- endstyle -%}

<div id="z3-{{ section.id }}">
  <div class="z3-wrap">

    <div class="z3-hero">
      {%- if section.settings.logo != blank -%}
        <img class="z3-logo" src="{{ section.settings.logo | image_url: width: 320 }}" alt="{{ shop.name }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" loading="lazy">
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1>{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- assign story_blocks = section.blocks | where: 'type', 'story' -%}
    {%- if story_blocks.size > 0 -%}
      <div class="z3-story">
        {%- for block in story_blocks -%}
          <div class="z3-story-card" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign product_blocks = section.blocks | where: 'type', 'product' -%}
    {%- if product_blocks.size > 0 -%}
      {%- if section.settings.preview_title != blank -%}
        <h2 class="z3-preview-title">{{ section.settings.preview_title }}</h2>
      {%- endif -%}
      {%- if section.settings.preview_subtitle != blank -%}
        <p class="z3-preview-sub">{{ section.settings.preview_subtitle }}</p>
      {%- endif -%}
      <div class="z3-grid">
        {%- for block in product_blocks -%}
          <div class="z3-product" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.title }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
            {%- else -%}
              <div class="z3-ph">🧩</div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}<h4>{{ block.settings.title }}</h4>{%- endif -%}
            {%- if block.settings.tag != blank -%}<div class="z3-tag">{{ block.settings.tag }}</div>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_signup -%}
      <div class="z3-signup">
        {%- if section.settings.signup_title != blank -%}<h3>{{ section.settings.signup_title }}</h3>{%- endif -%}
        {%- if section.settings.signup_text != blank -%}<p>{{ section.settings.signup_text }}</p>{%- endif -%}

        {%- form 'customer', class: 'z3-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter, z3-launch">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.signup_placeholder }}"
            required
            aria-label="Email">
          <button type="submit">{{ section.settings.signup_button }}</button>
          {%- if form.posted_successfully? -%}
            <p class="z3-success">{{ section.settings.signup_success }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Z3 Landing",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#00A6A6" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#0E1116" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#F4F4F5" },

    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Z3 Collective" },
    { "type": "textarea", "id": "subheading", "label": "Subheadline", "default": "Custom 3D-printed creations, designed and made by kids. Full shop launching soon." },

    { "type": "header", "content": "Product preview" },
    { "type": "text", "id": "preview_title", "label": "Preview title", "default": "A peek at what's coming" },
    { "type": "text", "id": "preview_subtitle", "label": "Preview subtitle", "default": "Get on the list to shop these first." },

    { "type": "header", "content": "Email signup" },
    { "type": "checkbox", "id": "show_signup", "label": "Show email signup", "default": true },
    { "type": "text", "id": "signup_title", "label": "Signup title", "default": "Be first in line" },
    { "type": "textarea", "id": "signup_text", "label": "Signup text", "default": "Drop your email and we'll tell you the moment the shop opens." },
    { "type": "text", "id": "signup_placeholder", "label": "Input placeholder", "default": "you@email.com" },
    { "type": "text", "id": "signup_button", "label": "Button text", "default": "Notify me" },
    { "type": "text", "id": "signup_success", "label": "Success message", "default": "You're on the list! 🎉" }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Made by kids" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Every item is designed, printed, and packed by our young makers." }
      ]
    },
    {
      "type": "product",
      "name": "Product preview",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "title", "label": "Name", "default": "Product name" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Coming soon" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Z3 Landing",
      "blocks": [
        { "type": "story" },
        { "type": "story" },
        { "type": "story" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
